# Database
DATABASE_URL=postgresql+asyncpg://istory:istory_dev_password@localhost:5432/istory

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Quarantine Triggers (Configurable)
QUARANTINE_STORY_SCORE_THRESHOLD=-5
QUARANTINE_USER_REPUTATION_THRESHOLD=-20
QUARANTINE_MIN_REPORTS=3
QUARANTINE_SPAM_CONFIDENCE=0.8
QUARANTINE_RAPID_POSTING_COUNT=5

# Content validation
CONTENT_URL_MIN_REPUTATION=50
CONTENT_DUPLICATE_LOOKBACK=200

# Redis rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=60

# Scoring (Bayesian / Wilson / trust)
BAYESIAN_PRIOR_MEAN=0.0
BAYESIAN_PRIOR_WEIGHT=10.0
WILSON_Z=1.96
TRUST_CONSTANT=100
SCORE_SCALE=100
REPUTATION_SCALE=1000
RAPID_POSTING_MIN_HOURS=1.0

# Application
APP_NAME=Interactive Story App
APP_VERSION=1.0.0
DEBUG=True
