# Database
DATABASE_URL=postgresql+asyncpg://istory:istory_dev_password@localhost:5432/istory

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Quarantine Triggers (Configurable)
QUARANTINE_STORY_SCORE_THRESHOLD=-5
QUARANTINE_USER_REPUTATION_THRESHOLD=-20
QUARANTINE_MIN_REPORTS=3
QUARANTINE_SPAM_CONFIDENCE=0.8
QUARANTINE_RAPID_POSTING_COUNT=5

# Content validation
CONTENT_DUPLICATE_LOOKBACK=200

# Hacked-account / velocity anomaly
VELOCITY_MIN_ACCOUNT_AGE_HOURS=24
VELOCITY_POST_BURST_LIMIT=5
VELOCITY_POST_WINDOW_SECONDS=300
VELOCITY_VOTE_BURST_LIMIT=25
VELOCITY_VOTE_WINDOW_SECONDS=60

# Redis rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=60

# Scoring (Bayesian / Wilson / trust)
BAYESIAN_PRIOR_MEAN=0.0
BAYESIAN_PRIOR_WEIGHT=10.0
WILSON_Z=1.96
TRUST_CONSTANT=100
SCORE_SCALE=100
REPUTATION_SCALE=1000
RAPID_POSTING_MIN_HOURS=1.0

WARN_DEFAULT_HOURS=24
VOTING_PATTERN_LOOKBACK_HOURS=24
VOTING_PATTERN_DOWNVOTE_THRESHOLD=15
SIBLING_BRANCH_COOLDOWN_SECONDS=3600
MAX_CONCURRENT_OPEN_TREES=3
MIN_REPUTATION_CREATE_ROOT=50

# Application
APP_NAME=Interactive Story App
APP_VERSION=1.0.0
DEBUG=True
